# /etc/openexchange/aeronmd/<name>.env: one external media driver's knobs (aeronmd@<name>.service). Optional file.
# The driver directory; the unit's default is /dev/shm/aeron-openexchange-<name>, the same default its client unit
# uses. Change it in both or in neither.
#AERON_DIR=/dev/shm/aeron-openexchange-core
# dev: SHARED threading, backoff idles. prod: DEDICATED threading, busy-spin idles (three spinning threads).
AERON_DRIVER_PROFILE=prod
# A taskset CPU list for the driver, off its process's CPUs. Empty: unpinned.
DRIVER_CPU_SET=
