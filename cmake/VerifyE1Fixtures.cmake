# The E1 corpus fixtures of the C++ bridge (RC2 S9b W1, S9h 4.1 and section 8): domain/bridge/tests/fixtures/e1/ is
# written ONLY by the S9h harness (`regen.sh - - <jar>`, the `e1` command) from the J-ME3 capture pinned by
# me_journal_e1_match_ref / me_journal_e1_sums_sha256. Every listed file must hash as its line in SHA256SUMS,
# SHA256SUMS must hash as me_journal_e1_fixtures_sha256sums_sha256, e1.pin must name the lock's capture commit and
# corpus SUMS, and the directory may hold no file SHA256SUMS does not list. A hand-edited fixture, or a regenerated
# corpus copied in without a lock bump, fails configure. Runs at configure in every build (no Java, no Aeron) and
# from the bridge.e1_fixture_guard test as
#   cmake -DCT_FIXTURE_DIR=<dir> -DCT_LOCK_FILE=<dependencies.lock> -P VerifyE1Fixtures.cmake
# The lock is read with a regex (the cmake 3.16 floor of the fast job).

function(ct_e1_lock_value lock key out)
    string(REGEX MATCH "\"${key}\"[ \t]*:[ \t]*\"([0-9a-f]*)\"" _ "${lock}")
    set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(ct_verify_e1_fixtures fixture_dir lock_file)
    file(READ "${lock_file}" lock)
    ct_e1_lock_value("${lock}" me_journal_e1_fixtures_sha256sums_sha256 want_sums)
    ct_e1_lock_value("${lock}" me_journal_e1_sums_sha256 want_corpus)
    ct_e1_lock_value("${lock}" me_journal_e1_match_ref want_commit)
    foreach(v want_sums want_corpus)
        string(LENGTH "${${v}}" len)
        if(NOT len EQUAL 64)
            message(FATAL_ERROR "dependencies.lock: the E1 pin ${v} is not a sha256: '${${v}}'")
        endif()
    endforeach()
    string(LENGTH "${want_commit}" commit_len)
    if(NOT commit_len EQUAL 40)
        message(FATAL_ERROR "dependencies.lock: me_journal_e1_match_ref is not a full match commit sha: '${want_commit}'")
    endif()
    if(NOT EXISTS "${fixture_dir}/SHA256SUMS")
        message(FATAL_ERROR "E1 fixtures: ${fixture_dir}/SHA256SUMS is missing")
    endif()
    file(SHA256 "${fixture_dir}/SHA256SUMS" got_sums)
    if(NOT got_sums STREQUAL want_sums)
        message(FATAL_ERROR "E1 fixture SHA256SUMS has sha256 ${got_sums}; dependencies.lock pins ${want_sums}")
    endif()
    file(STRINGS "${fixture_dir}/SHA256SUMS" lines)
    set(names "")
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._/-]+)$")
            message(FATAL_ERROR "E1 fixture SHA256SUMS: malformed line '${line}'")
        endif()
        set(hash "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        if(name MATCHES "\\.\\.")
            message(FATAL_ERROR "E1 fixture SHA256SUMS: path '${name}' leaves the fixture directory")
        endif()
        if(NOT EXISTS "${fixture_dir}/${name}")
            message(FATAL_ERROR "E1 fixture missing: ${name}")
        endif()
        file(SHA256 "${fixture_dir}/${name}" got)
        if(NOT got STREQUAL hash)
            message(FATAL_ERROR "E1 fixture differs from SHA256SUMS: ${name}")
        endif()
        list(APPEND names "${name}")
    endforeach()
    file(STRINGS "${fixture_dir}/e1.pin" pin)
    if(NOT pin MATCHES "match_commit=${want_commit}" OR NOT pin MATCHES "sums_sha256=${want_corpus}")
        message(FATAL_ERROR "E1 fixtures: e1.pin (${pin}) does not name the lock's me_journal_e1_match_ref ${want_commit} "
            "and me_journal_e1_sums_sha256 ${want_corpus}")
    endif()
    file(GLOB_RECURSE present RELATIVE "${fixture_dir}" "${fixture_dir}/*")
    list(REMOVE_ITEM present SHA256SUMS ${names})
    if(present)
        message(FATAL_ERROR "E1 fixture dir holds files SHA256SUMS does not name: ${present}")
    endif()
    list(LENGTH names count)
    if(count LESS 4)
        message(FATAL_ERROR "E1 fixture SHA256SUMS lists ${count} files: not a corpus")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT DEFINED CT_FIXTURE_DIR OR NOT DEFINED CT_LOCK_FILE)
        message(FATAL_ERROR "usage: cmake -DCT_FIXTURE_DIR=<dir> -DCT_LOCK_FILE=<lock> -P VerifyE1Fixtures.cmake")
    endif()
    ct_verify_e1_fixtures("${CT_FIXTURE_DIR}" "${CT_LOCK_FILE}")
    message(STATUS "E1 fixtures verified: ${CT_FIXTURE_DIR}")
endif()
