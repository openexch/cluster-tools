# The ME journal schema 4 golden fixtures (RC2 S9a contract 9.2, FixtureGuard): byte copies of
# match's MeJournalFixtureDump output at me_journal_fixture_source_commit. Every .bin must hash as
# its line in SHA256SUMS and SHA256SUMS must hash as the lock pins, so a drifted copy, or a
# regenerated match dump copied in without a lock bump, fails configure. Runs at configure in
# every build (no Java, no Aeron) and from the archive.fixture_guard test as
#   cmake -DCT_FIXTURE_DIR=<dir> -DCT_LOCK_FILE=<dependencies.lock> -P VerifyMeJournalFixtures.cmake
# The lock is read with a regex, not string(JSON), so the cmake 3.16 floor of the fast job holds.

function(ct_verify_me_journal_fixtures fixture_dir lock_file)
    file(READ "${lock_file}" lock)
    string(REGEX MATCH "\"me_journal_fixture_sha256sums_sha256\"[ \t]*:[ \t]*\"([0-9a-f]*)\"" _ "${lock}")
    set(want_sums "${CMAKE_MATCH_1}")
    string(REGEX MATCH "\"me_journal_fixture_source_commit\"[ \t]*:[ \t]*\"([^\"]*)\"" _ "${lock}")
    set(commit "${CMAKE_MATCH_1}")
    string(LENGTH "${want_sums}" want_len)
    if(NOT want_len EQUAL 64)
        message(FATAL_ERROR "dependencies.lock: me_journal_fixture_sha256sums_sha256 is not a sha256: '${want_sums}'")
    endif()
    string(LENGTH "${commit}" commit_len)
    if(NOT commit MATCHES "^[0-9a-f]+$" OR NOT commit_len EQUAL 40)
        message(FATAL_ERROR "dependencies.lock: me_journal_fixture_source_commit is not a full match commit sha: '${commit}'")
    endif()
    if(NOT EXISTS "${fixture_dir}/SHA256SUMS")
        message(FATAL_ERROR "ME journal fixtures: ${fixture_dir}/SHA256SUMS is missing")
    endif()
    file(SHA256 "${fixture_dir}/SHA256SUMS" got_sums)
    if(NOT got_sums STREQUAL want_sums)
        message(FATAL_ERROR "ME journal fixture SHA256SUMS has sha256 ${got_sums}; dependencies.lock pins ${want_sums}")
    endif()
    file(STRINGS "${fixture_dir}/SHA256SUMS" lines)
    set(names "")
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._-]+)$")
            message(FATAL_ERROR "ME journal fixture SHA256SUMS: malformed line '${line}'")
        endif()
        set(hash "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        if(NOT EXISTS "${fixture_dir}/${name}")
            message(FATAL_ERROR "ME journal fixture missing: ${name}")
        endif()
        file(SHA256 "${fixture_dir}/${name}" got)
        if(NOT got STREQUAL hash)
            message(FATAL_ERROR "ME journal fixture differs from SHA256SUMS: ${name}")
        endif()
        list(APPEND names "${name}")
    endforeach()
    set(required java-command.conflict.bin java-command.first.bin java-config.bin java-release.bin
        java-terminal.bin java-trade.bin)
    if(NOT names STREQUAL required)
        message(FATAL_ERROR "ME journal fixture SHA256SUMS must list exactly: ${required}; lists ${names}")
    endif()
    file(GLOB present RELATIVE "${fixture_dir}" "${fixture_dir}/*")
    list(REMOVE_ITEM present SHA256SUMS ${required})
    if(present)
        message(FATAL_ERROR "ME journal fixture dir holds files SHA256SUMS does not name: ${present}")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT DEFINED CT_FIXTURE_DIR OR NOT DEFINED CT_LOCK_FILE)
        message(FATAL_ERROR "usage: cmake -DCT_FIXTURE_DIR=<dir> -DCT_LOCK_FILE=<lock> -P VerifyMeJournalFixtures.cmake")
    endif()
    ct_verify_me_journal_fixtures("${CT_FIXTURE_DIR}" "${CT_LOCK_FILE}")
    message(STATUS "ME journal fixtures verified: ${CT_FIXTURE_DIR}")
endif()
